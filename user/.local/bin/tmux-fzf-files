#!/usr/bin/env bash

mode="${1:-split}"

selected="$(
    find $HOME -type f -not -path './.git/*' 2>/dev/null |
    fzf --reverse \
        --border \
        --prompt="Files > " \
        #--preview='bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null'
)" || exit 0

[ -z "$selected" ] && exit 0

case "$mode" in
    split)
        tmux split-window -h -c "$PWD" \
            "nvim -- $(printf '%q' "$selected")"
        ;;
    window)
        tmux new-window -c "$PWD" \
            "nvim -- $(printf '%q' "$selected")"
        ;;
esac
